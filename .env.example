# Example environment variables
# Vite exposes only variables that start with VITE_ to the client.
# Put server-only secrets (not prefixed with VITE_) on the host (Vercel/Netlify) or process env.

# Client (exposed to browser)
VITE_API_URL=https://api.example.com
VITE_PUBLIC_PATH=/

# Server (private)
NODE_ENV=production
PORT=3000
